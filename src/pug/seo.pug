extends _layout/default

block vars
  -title        = 'Seo'
  -description  = ''
  -keywords     = ''
  -og_title     = ''
  -url          = ''
  -pageID       = 'p-seo'
  -path         = '.'

block scripts

block container
  section.hero.section.hero--sec
    div(class="hero__gradient")
    .container
      .hero__inner
        p.js-text(class="hero__eyebrow" ) "SEO mãi không lên"
        h1.js-text(class="hero__title" )
          | Nhận Action Plan&nbsp;
          br.is-mb
          | tăng trưởng &nbsp;
          br.is-pc
          | chỉ&nbsp;
          br.is-mb
          span sau 7-10 ngày
        p.js-text(class="hero__lead")
          | Phá vỡ nút thắt Website với lộ trình Audit toàn diện và&nbsp;
          br.is-pc
          | Chiến lược "đo ni đóng giày" từ chuyên gia&nbsp;
          strong 6+ năm kinh nghiệm.
        form(action="#")
          .form-wrap.js-text
            .form-group.item-2
              label
                input(type="text" placeholder="Tên")
              label
                input(type="email" placeholder="Email")
            .form-group.item-2
              label
                input(type="text" placeholder="Domain website")
              label
                input(type="text" placeholder="SDT")
            .lead-action
              button.btn(type="submit")
                span nhận bản audit 360 độ
      figure.js-text(class="hero__team")
        .hero__img.img--1
          +img("seo/hero1.png")
        .hero__img.img--2
          +img("seo/hero2.png")
        .hero__img.img--3
          +img("seo/hero4.png")
        .hero__img-col
          .hero__img.img--4
            +img("seo/hero3.png")
          .hero__img.img--5
            +img("seo/hero5.png")
  section.results.section.results--sec
    .container
      .slider-wrapper.results-grid.js-text.js-result
        +Swiperhtml
          .swiper-slide
            article.metric-card
              +img("common/traffic.png")
              h3.metric-tt 2M+
              p Traffic/tháng
          .swiper-slide
            article.metric-card
              +img("common/url.png")
              h3.metric-tt 100N+
              p URL hệ thống được tối ưu Technical
          .swiper-slide
            article.metric-card
              +img("common/seo.png")
              h3.metric-tt 200+
              p Dự án SEO tổng thể thành công
          .swiper-slide
            article.metric-card
              +img("common/b2b.png")
              h3.metric-tt 6+ Năm
              p Đồng hành cùng Doanh nghiệp B2B
        .swiper-pagination.js-text
  section.trust.section.is-decora
    .trust__wrap.js-text
      .trust__txt
        p Được khách hàng tin tưởng và đồng hành:
      .trust__brand
        ul.trust__brand-list.scroll1
          each item, id in Array(10)
            li.trust__brand-item
              +img(`common/brand${id + 1}.png`)
  section.fields.section.is-decora.fields--sec
    .container
      p.js-text.tt-sub Tại sao nỗ lực SEO của bạn
      h2.sec-tt.js-text
        span chưa ra kết quả?
      .business-types.js-text
        .business-item
          .business-card
            h3.fw-b Từ khóa của bạn cứ mãi chìm đắm ở trang 2, trang 3
            .mona-content
              p Liên tục tối ưu nội dung, tối ưu backlink, tốn không ít công sức, thời gian và tiền bạc, nhưng trang của bạn mãi vẫn không “chinh phục” được trang nhất.
        .business-item
          .business-card
            h3.fw-b Từ khóa/ traffic rớt không phanh mà không tìm được nguyên nhân
            .mona-content
             p Bạn từng SEO có hiệu quả tốt, traffic cao nhưng bỗng nhiên biểu đồ “cắm đầu” và thứ hạng dần dần rơi hết vào tay đối thủ.
        .business-item
          .business-card
            h3.fw-b Từ khóa vào được trang 1 nhưng vẫn không có khách hàng nào liên hệ?
            .mona-content
              p Bạn nghi ngờ rằng liệu mình có đang đầu tư đúng và SEO có thực sự cần thiết?
        .business-item
          .business-card
            h3.fw-b Muốn tăng trưởng doanh thu từ kênh SEO vì đã đến mùa cao điểm của ngành?
            .mona-content
              p Làm sao để có một chiến lược SEO hiệu quả, thu hút thật nhiều khách hàng tiềm năng kịp thời.
  section.problem.section.is-decora
    .container
      p.js-text.tt-sub Rất có thể bạn đang mắc phải
      h2.sec-tt.js-text
        span 05 sai lầm này
      .problem-grid.js-text
        .problem-card
          .circle
            p Website đã thay đổi quá nhiều về giao diện, code và URL
        .problem-card
          .circle
            p Website sở hữu nhiều domain, sub-domain khác nhau

        .problem-card
          .circle
            p Website thiếu tính đồng bộ giữa desktop & mobile

        .problem-card
          .circle
            p Chưa nghiên cứu phân tích thị trường cùng ngành

        .problem-card
          .circle
            p Website đã đăng tải quá nhiều nội dung trong thời gian dài
  section.fields.section.is-decora.fields--sec
    .container
      h2.sec-tt.js-text
        span SEO Strategy
      p.tt-sub.js-text Không chỉ là Audit, đó là "Bản đồ tăng trưởng"
      .tt-desc.mona-content.js-text
        p Khác với dịch vụ SEO, SEO Strategy là dịch vụ cung ứng chiến lược SEO từ chuyên gia. Chúng tôi giúp doanh nghiệp loại bỏ nhiều lo lắng và trở ngại khi tìm kiếm giải pháp SEO inhouse chất lượng
      .domains-grid.js-text
        each item, id in [{tt:"Audit toàn diện", desc:"Audit Webiste giúp xác định gốc rễ và xử lý vấn đề kìm hãm Website"}, {tt:"Research đối thủ & thị trường", desc:"Data SEO thị trường và các đối thủ cạnh tranh trong 2 năm gần nhất"}, {tt:"Chiến lược tối ưu", desc:'Làm rõ topic SEO "win" để tập trung nguồn lực, tránh lãng phí tài nguyên'}, {tt:'Plan SEO 6-12 tháng', desc:"Action plan SEO vận hành 6-12 tháng được xây bởi chuyên gia SEO"}]
          .domain-item
            .domain-icon
              +img(`seo/stategy${id + 1}.png`)
            h3.domain-tt=item.tt
            .mona-content
              p=item.desc
      .tt-desc.mona-content.js-text
        p Khác với dịch vụ SEO thực thi, chúng tôi cung cấp "Bộ não chiến lược" được đúc kết từ kinh nghiệm thực chiến điều phối các dự án triệu Traffic (>1M/tháng). Midas giúp bạn biết chính xác CÁI GÌ cần làm, TẠI SAO làm và KHI NÀO có kết quả để tối ưu hóa nguồn lực cao nhất.
  section.benefit.section
    .container
      h2.sec-tt.js-text BẠN SẼ NHẬN ĐƯỢC GÌ&nbsp;
        span SAU 7-10 NGÀY?
      .benefit-grid.js-text
        .benefit-card
          h3.benefit-tt 1. Bản đồ Chiến lược Tăng trưởng (Master Plan 6-12 tháng)
          .mona-content
            p Bản kế hoạch SEO tổng thể giúp doanh nghiệp thoát khỏi các hành động rời rạc. Master Plan bao gồm &nbsp;
              i lộ trình thực thi theo từng giai đoạn, xác định rõ các Topic "Win" và phương án phủ lấp lỗ hổng nội dung (Content Gap) để&nbsp;
              strong chiếm lĩnh thị trường bền vững.

        .benefit-card
          h3.benefit-tt 2. Hệ thống Từ khóa Doanh thu (Keyword Strategy Map)
          .mona-content
            p Không chỉ là danh sách từ khóa, đây là bộ từ khóa được phân loại theo intent (Search Intent) và tiềm năng chuyển đổi. Dựa trên dữ liệu thực tế 2 năm gần nhất, chúng tôi giúp bạn ưu tiên những từ khóa mang lại traffic và bộ từ khóa "ăn tiền" nhất cho doanh nghiệp.

        .benefit-card
          h3.benefit-tt 3. Hồ sơ Audit Website toàn diện (Technical & Entity Audit)
          .mona-content
            p Bản kiểm tra chuyên sâu giúp bạn phát hiện tất cả những lỗi kỹ thuật và cấu trúc thực thể (Entity). Chúng tôi cũng sẽ đề xuất giải pháp cụ thể để khắc phục ngay lập tức các vấn đề khiến website của bạn đang "ngủ đông" trong mắt Google AI Search.

        .benefit-card
          h3.benefit-tt 4. Hệ thống Quản trị Mục tiêu (OKRs & Tracking Dashboard)
          .mona-content
            p Bảng điều khiển OKRs và SEO được thiết kế theo từng mục tiêu. Chúng tôi thiết lập hệ thống OKRs & KPI theo dõi tiến độ, giúp bạn nắm bắt tình hình thực tế dự án, dự báo tăng trưởng và điều chỉnh kịp thời.

        .benefit-card
          h3.benefit-tt 5. Chuyển giao & Cố vấn chuyên sâu (Coaching & Support)
          .mona-content
            p Buổi Coaching 1:1 trực tiếp cùng chuyên gia. Định hướng giao toàn bộ "chìa khóa" kiến thức cho đội ngũ của bạn. Bạn cần gì là tôi sẽ hướng dẫn tận tình theo kiểu "Bác sĩ SEO" của Midas, sẵn sàng giải đáp mọi thắc mắc chuyên môn và theo dõi hỗ trợ trong suốt quá trình vận hành.

        .benefit-card
          h3.benefit-tt 6. Siêu quà tặng độc quyền: Bộ tài liệu Audit 25 Triệu
          .mona-content
            p Tổng cộng hơn 25.000.000 VNĐ được tặng kèm Audit Website chuyên sâu trị giá 25.000.000 VNĐ được thiết kế kỹ lưỡng dành cho doanh nghiệp. Đây là tài sản kiến thức giúp doanh nghiệp tự làm chủ kỹ năng tối ưu, duy trì sự cạnh tranh và phát triển mà không còn phụ thuộc hoàn toàn vào Agency bên ngoài.
      .btn-wrap.js-text
        a.btn.btn--sec(href="#lead-form")
          span báo giá dịch vụ seo strategy
          +img("seo/btn.svg")
    .global.js-text
      +img("seo/global.jpg")
  section.process.section.process--sec.is-decora
    .container
      h2.sec-tt.t-ct.js-text
        | Quy trình &nbsp;
        span Audit & Lập phác đồ "thần tốc"
      #timeline.c-timeline
        //- div(
        //-   aria-hidden="true"
        //-   class="c-timeline_progress"
        //-   )
        //-   #timeline-progress(class="c-timeline_progress-bar")
        .timeline-wrap
          article(class="c-timeline_item")
            .c-wrap.cc-align_left
              div(class="cc-timeline_item")
                p.timeline-step 01.
                h2.timeline-tt Thiết lập nền tảng
                  br
                  | & Audit triệt để
            .c-wrap(class="cc-align_center")
              div(class="timeline_circle")
            .c-wrap.cc-align_right
              .c-card
                .mona-content
                  p
                    strong Phương án:
                    | &nbsp;Phân tích đối thủ và nghiên cứu thị trường chuyên sâu để tháo gỡ nút thắt "SEO không hiệu quả".
                  p
                    strong Mục tiêu:
                    | &nbsp;Hoàn thiện lộ trình Audit chỉ từ 7-10 ngày. Kiểm tra toàn diện lỗ hổng kỹ thuật và thực thể (Entity) để không bị AI "ngó lơ".
          article(class="c-timeline_item")
            .c-wrap.cc-align_left
              div(class="cc-timeline_item")
                p.timeline-step 02.
                h2.timeline-tt Xây dựng "Phác đồ"
                  br
                  | Content Marketing
            .c-wrap(class="cc-align_center")
              div(class="timeline_circle")
            .c-wrap.cc-align_right
              .c-card
                .mona-content
                  p
                    strong Phương án:
                    | &nbsp;Thiết kế chiến lược Content Funnel độc quyền, dẫn dắt khách hàng từ nhận biết đến hành vi mua hàng.
                  p
                    strong Giá trị:
                    | &nbsp;Nội dung được tối ưu "kép": Vừa chạm đúng ý định tìm kiếm (SEO), vừa được cấu trúc để AI dễ dàng trích dẫn (GEO).
          article(class="c-timeline_item")
            .c-wrap.cc-align_left
              div(class="cc-timeline_item")
                p.timeline-step 03.
                h2.timeline-tt Kích hoạt bộ đôi
                  br
                  | Content & Backlink
            .c-wrap(class="cc-align_center")
              div(class="timeline_circle")
            .c-wrap.cc-align_right
              .c-card
                .mona-content
                  p
                    strong Phương án:
                    | &nbsp;Kết hợp sức mạnh nội dung chất lượng và hệ thống Backlink uy tín để tạo "phiếu bầu" năng lực cho Website.
                  p
                    strong Giá trị:
                    | &nbsp;Chiếm lĩnh TOP 1-3 Google và trở thành Trusted Source (Nguồn tin cậy) được AI đề xuất ưu tiên.
          article(class="c-timeline_item")
            .c-wrap.cc-align_left
              div(class="cc-timeline_item")
                p.timeline-step 04.
                h2.timeline-tt Thực thi Chiến
                  br
                  | lược & Chuyển giao
            .c-wrap(class="cc-align_center")
              div(class="timeline_circle")
            .c-wrap.cc-align_right
              .c-card
                .mona-content
                  p
                    strong Phương án:
                    | &nbsp;Triển khai Action Plan 6-12 tháng được "đo ni đóng giày" theo nội lực doanh nghiệp.
                  p
                    strong Giá trị:
                    | &nbsp;MIDAS trực tiếp chuyển giao tài liệu và hướng dẫn đội ngũ nội bộ vận hành, đảm bảo tính bền vững dài hạn.
          article(class="c-timeline_item")
            .c-wrap.cc-align_left
              div(class="cc-timeline_item")
                p.timeline-step 05.
                h2.timeline-tt Tối ưu hóa Hiệu
                  br
                  | quả & Traffic
            .c-wrap(class="cc-align_center")
              div(class="timeline_circle")
            .c-wrap.cc-align_right
              .c-card
                .mona-content
                  p
                    strong Phương án:
                    | &nbsp;Báo cáo Real-time minh bạch, tập trung vào kết quả thực tế.
                  p
                    strong Giá trị:
                    | &nbsp;Minh chứng năng lực qua con số 2 triệu lượt traffic mỗi tháng cho các đối tác toàn cầu.

