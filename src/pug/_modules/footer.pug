            a(href="#")
              +img("common/fb.svg")
            a(href="#")
              +img("common/ytb.svg")
            a(href="#")
              +img("common/github.svg")
        .footer-box.footer-form
          p.footer-tt Đăng ký nhận bảng tin
          form.newsletter-form(
            action="/"
