header.header.js-header#header
  .container
    .header-wrap
      .header-logo.logo-main
        +img("common/logo.png")
      .header-logo.logo-white
        +img("common/logo-white.png")
      .header-main
        nav.header-nav.js-header-nav
          ul.menu-list
            each item, id in ['Trang Chủ','Dịch Vụ', 'Case Study', 'Về Chúng Tôi', 'Tuyển  Dụng', 'Kiến Thức SEO Và AI' ]
              li.menu-item(class=`${id === 0 ? "current-menu-item" : ""} `)
                a(href="#")=item
        .header-action
          a(href="#").header-btn.logo-main
            span.hide-sitename NHẬN TƯ VẤN
            +img("common/header-btn.png")
          a(href="#").header-btn.logo-white
            span NHẬN TƯ VẤN
          .menu-bar.js-bar
            .menu-icon