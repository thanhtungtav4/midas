                  div(class="press-article__source")
                    span Nguồn:&nbsp;
                    a(href="#") Midas Agency: Giải mã Zero-Click, đưa Website thành nguồn tin cậy của Google AI
        .swiper-pagination
  a(href="#").global.js-text
    +img("common/global2.jpg")

  section#lead-form.lead.section(aria-labelledby="lead-title")
    .container(class="lead__container")
      h2#lead-title.sec-tt(class="lead__title")
