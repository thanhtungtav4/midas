          label
            span SĐT
            input(
              required=""
              autocomplete="tel"
              name="phone"
              type="tel"
              )
          label
            span Email
            input(
              required=""
              autocomplete="email"
              name="email"
              type="email"
              )
        div(class="lead-form__row")
          label
