extends _layout/default

block vars
  -title        = 'Homepage'
  -description  = ''
  -keywords     = ''
  -og_title     = ''
  -url          = ''
  -pageID       = 'homepage'
  -path         = '.'

block scripts

block container

  section.hero.section
    div(class="hero__gradient")
    .container
      p.js-text(class="hero__eyebrow" ) Vị thế tiên phong thăng hạng Website
      h1.js-text(class="hero__title" )
        | từ&nbsp;
        span TOP 10 LÊN TOP 1
        br
        | &nbsp;& CHIẾM LĨNH&nbsp;
        span AI OVERVIEW
      p.js-text(class="hero__lead")
        | Không dừng lại ở SEO truyền thống, Midas tiên phong ứng dụng GEO
        |   (Generative Engine Optimization). Chúng tôi chuẩn hóa nền tảng
        |   Technical, biến Website thành “Nguồn tin cậy” (Trusted Source) để
        |   được AI ưu tiên lựa chọn trong kỷ nguyên Search 2026.
      div.js-text(class="hero__actions")
        a.btn(href="#")
          span Đăng ký tư vấn SEO
        a.btn.btn--sec(href="#")
          span Báo giá dịch vụ
      .hero__star.js-text
        +img("common/star.svg")
      .hero__lead.tt-25
        blockquote.js-text(class="hero__quote tt-24")
          | “Cốt lõi của MIDAS là sự học hỏi không ngừng để dẫn đầu. Chúng tôi
          |   kết hợp giữa dữ liệu thực chiến và công nghệ GEO tiên phong để đảm
          |   bảo rằng thương hiệu của bạn không chỉ lên Top, mà còn trở thành
          |   nguồn tin cậy nhất trong mắt khách hàng.”
        aside.js-text(
          aria-label="Tác giả trích dẫn"
          class="hero__author"
          )
          div(class="hero__author-card")
            p(class="hero__author-name") Bảo Danh
            p(class="hero__author-role") CEO of Midas Agency
    figure.js-text(class="hero__team")
      +img("common/team1.png")
  section.about.section.is-decora
    .container
      article.about-card
        h2.sec-tt.js-text CHÚNG TÔI LÀ MIDAS
        p.tt-sub.js-text
          span 6+ năm
          | &nbsp;đồng hành cùng doanh nghiệp
          br
          | &nbsp;chinh phục&nbsp;
          span top 1 - 3
        p.js-text(class="about-card__body tt-24 t-ct")
          | Chúng tôi sở hữu kinh nghiệm triển khai Marketing Online
          br
          | &nbsp;cho hơn
          | 200 doanh nghiệp, bao gồm 30 lĩnh vực đa dạng như sức khoẻ, việc
          | làm, đầu tư, định cư, thời trang, xây dựng, hàng không và điện
          | máy, đảm bảo sự am hiểu sâu rộng và hiệu quả cao trong từng chiến
          | dịch.
  section.results.section.is-decora
    .container
      h2.sec-tt.js-text KẾT QUẢ THỰC - GIÁ TRỊ THỰC
      .slider-wrapper.results-grid.js-text.js-result
