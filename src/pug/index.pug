  a(href="#").global.js-text
    +img("common/global1.jpg")
  section.process.section
    .container
      h2.sec-tt.t-ct.js-text
        | MIDAS GIÚP BẠN&nbsp;
        span NHƯ THẾ NÀO?
      p.tt-24.t-ct.js-text Quy trình làm việc chuẩn để MIDAS Agency giúp khách hàng hiện diện bền vững trên Search Engines & AI
      .c-timeline
        .c-timeline_progress
          .c-timeline_progress-bar
        each item in Array(4)
          .c-timeline_item
            .c-wrap
              .c-wrap.cc-timeline_item
                p.timeline-step 01.
                p.timeline-tt Thiết lập nền tảng & Audit triệt để
            .c-wrap.cc-align_center
              .timeline_circle
            .c-wrap
              .c-card
                .timeline-box
                  .mona-content
                    p
                      strong Phương án:
                      | &nbsp;Phân tích đối thủ và nghiên cứu thị trường chuyên sâu để tháo gỡ nút thắt "SEO không hiệu quả".
                    p
                      strong Phương án:
                      | &nbsp;Phân tích đối thủ và nghiên cứu thị trường chuyên sâu để tháo gỡ nút thắt "SEO không hiệu quả".
