      .hero__star.js-text
        +img("common/star.svg")
      figure.js-text(class="hero__team")
        +img("common/hero.png")
      div.js-text(class="hero__actions")
        a.btn(href="https://midas.vn/")
          span Đăng ký tư vấn SEO
        a.btn(href="#lead-form").btn.btn--sec
          span Báo giá dịch vụ
