              h3.metric-tt 2M+
              p Traffic/tháng
          .swiper-slide
            article.metric-card
              +img("common/url.png")
              h3.metric-tt 100N+
              p URL hệ thống được tối ưu Technical
          .swiper-slide
            article.metric-card
              +img("common/seo.png")
              h3.metric-tt 200+
              p Dự án SEO tổng thể thành công
          .swiper-slide
            article.metric-card
              +img("common/b2b.png")
